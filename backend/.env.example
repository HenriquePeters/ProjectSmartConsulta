# ============================================================
# Smart Consulta — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores
# ============================================================

# Servidor
PORT=3000
NODE_ENV=development

# JWT — troque por uma string longa e aleatória em produção!
JWT_SECRET=smart_consulta_super_secret_key_troque_em_producao
JWT_EXPIRES_IN=7d

# Banco de dados (SQLite para dev, PostgreSQL para prod)
DB_DIALECT=sqlite
DB_STORAGE=./database/smart_consulta.db

# PostgreSQL (usar em produção)
# DB_DIALECT=postgres
# DATABASE_URL=postgresql://usuario:senha@host:5432/smart_consulta
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=smart_consulta
# DB_USER=postgres
# DB_PASS=sua_senha_aqui
DB_SSL=false

# E-mail (Nodemailer) — configure com seu provedor SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=sua_senha_de_app_gmail
EMAIL_FROM="Smart Consulta <seuemail@gmail.com>"

# URL(s) do frontend (para CORS)
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000,https://smart-consulta-dev-hp-20260407.web.app,https://smart-consulta-dev-hp-20260407.firebaseapp.com,https://smart-consulta-prd-hp-260407.web.app,https://smart-consulta-prd-hp-260407.firebaseapp.com

# Taxa de cancelamento (%)
CANCEL_FEE_UNDER_24H=30
CANCEL_FEE_UNDER_48H=10
CANCEL_FEE_SAME_DAY=50

# Upload de arquivos
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads
