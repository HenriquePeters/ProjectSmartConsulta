{
  "name": "smart-consulta-backend",
  "version": "1.0.0",
  "description": "Backend da plataforma Smart Consulta — Revolucionando Agendamentos Médicos",
  "main": "server.js",

  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",

    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage --runInBand --forceExit"
  },

  "jest": {
    "testEnvironment": "node",

    "setupFiles": [
      "./tests/setup.js"
    ],

    "testMatch": [
      "**/*.test.js"
    ],

    "testPathIgnorePatterns": [
      "/node_modules/"
    ],

    "testTimeout": 30000,

    "verbose": true
  },

  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "smart-consulta-workspace": "file:..",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0"
  },

  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  },

  "engines": {
    "node": ">=18.0.0"
  }
}